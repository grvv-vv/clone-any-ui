      "smooth-in-out": "cubic-bezier(0.4, 0, 0.2, 1)",
      "accelerate": "cubic-bezier(0.4, 0, 1, 1)",
      "custom-ease-1": "cubic-bezier(0.16, 1, 0.3, 1)"
    },
