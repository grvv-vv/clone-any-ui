{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DesignTokensSchema",
  "type": "object",
  "properties": {
    "cssVariables": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "colors": {
      "type": "object",
      "properties": {
        "summary": { "type": "object" },
        "byRole": {
          "type": "object",
          "properties": {
            "accent": { "type": "array" },
            "neutral": { "type": "array" },
            "text-dark": { "type": "array" },
            "background-light": { "type": "array" }
          }
        }
      }
    },
    "typography": {
      "type": "object",
      "properties": {
        "fontFamilies": { "type": "array", "items": { "type": "string" } },
        "fontSizes": { "type": "array", "items": { "type": "string" } },
        "fontWeights": { "type": "array", "items": { "type": "string" } },
        "lineHeights": { "type": "array", "items": { "type": "string" } }
      }
    },
    "shape": {
      "type": "object",
      "properties": {
        "borderRadii": { "type": "array", "items": { "type": "string" } },
        "boxShadows": { "type": "array", "items": { "type": "string" } }
      }
    },
    "motion": {
      "type": "object",
      "properties": {
        "keyframes": { "type": "object" },
        "animations": { "type": "object" },
        "easings": { "type": "object" },
        "transitions": { "type": "object" },
        "hoverMicroInteractions": { "type": "array" }
      }
    }
  },
  "required": ["colors", "typography", "shape"]
}

